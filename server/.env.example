# Copy this file to server/.env and fill in real values.
# Never commit server/.env - it holds passwords.

# Supabase > Connect > Session pooler connection string (add ?sslmode=require at the end)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:5432/postgres?sslmode=require
